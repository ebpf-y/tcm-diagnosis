# ===== 数据库 =====
DATABASE_URL="file:./dev.db"

# ===== 文本大模型（OpenAI 兼容协议，默认 DeepSeek；不配置则进入演示模式）=====
# LLM_API_KEY="sk-xxxxxxxx"
# LLM_BASE_URL="https://api.deepseek.com"
# LLM_MODEL="deepseek-chat"

# 其他厂商示例（取消注释并替换 Key 即可切换）：
# Kimi:   LLM_BASE_URL="https://api.moonshot.cn/v1"  LLM_MODEL="moonshot-v1-8k"
# 智谱:   LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"  LLM_MODEL="glm-4-flash"
# 通义:   LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"  LLM_MODEL="qwen-plus"

# ===== 多模态图像模型（舌诊/面诊，默认阿里云百炼 Qwen-VL；不配置则演示模式）=====
# VISION_API_KEY="sk-xxxxxxxx"
# VISION_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# VISION_MODEL="qwen-vl-max"
# 智谱多模态示例：VISION_BASE_URL="https://open.bigmodel.cn/api/paas/v4"  VISION_MODEL="glm-4v-flash"
